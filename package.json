{
  "name": "ai-company",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "next build",
    "start": "node scripts/run.mjs start",
    "db:seed": "tsx src/server/db/seed.ts",
    "setup": "npm run db:seed",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/phase1.mjs && node e2e/phase2.mjs && node e2e/meeting.mjs",
    "db:generate": "drizzle-kit generate",
    "web:dev": "next dev -p 3000",
    "web:start": "next start -p 3000",
    "worker": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx worker/index.ts",
    "e2e:phase2": "node e2e/phase2.mjs",
    "e2e:meeting": "node e2e/meeting.mjs",
    "lite:build": "node lite/build.mjs",
    "db:restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "galmuri": "^2.40.3",
    "marked": "^18.1.1",
    "next": "^16.4.2",
    "pdfjs-dist": "^6.4.299",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
