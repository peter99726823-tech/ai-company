# ─── AI (PHASE 2부터 사용) ─────────────────────────────
# Claude API 키. 서버(Next.js API, 워커)에서만 읽습니다. 브라우저로 절대 보내지 않습니다.
ANTHROPIC_API_KEY=
# 기본 모델. 바꾸려면 여기만 수정하세요.
AI_MODEL=claude-opus-5-5
# 하루 API 비용 한도(USD). 넘으면 새 업무 실행을 멈춥니다.
AI_DAILY_BUDGET_USD=5
# 업무 1건당 최대 AI 호출 횟수
AI_MAX_CALLS_PER_TASK=3

# ─── 데이터 ───────────────────────────────────────────
DATABASE_PATH=./data/company.db

# ─── 외부 공개 시 필수 (로컬 전용이면 비워둠) ────────────
# 값이 있으면 모든 페이지와 API에 이 비밀번호가 필요합니다.
APP_PASSWORD=
