# 이 파일을 .env.local로 복사해서 채우세요. .env.local은 git에 올라가지 않습니다.

# ─── AI ───────────────────────────────────────────────
# Claude API 키. 업무 실행기(워커)만 읽습니다. 브라우저로 절대 보내지 않습니다.
ANTHROPIC_API_KEY=
# 직원들이 쓰는 모델
AI_MODEL=claude-opus-5-5
# 생각 깊이: low | medium | high | xhigh | max  (높을수록 품질↑ 비용↑)
AI_EFFORT=high
# 웹 검색: on 이면 최신 자료를 실제로 검색합니다 (검색 1회당 약 0.01달러 추가). 기본 off
AI_WEB_SEARCH=off
# 모델이 안전 정책으로 거절하면 서버에서 대체 모델로 다시 처리: default | off
AI_FALLBACKS=default
# 하루 API 비용 한도(USD). 넘으면 새 업무를 실행하지 않고 실패로 기록합니다.
AI_DAILY_BUDGET_USD=5
# 업무 1건당 최대 AI 호출 횟수 (재시도 포함)
AI_MAX_CALLS_PER_TASK=3
# 보고서 최대 출력 토큰
AI_MAX_OUTPUT_TOKENS=32000
# 동시에 실행할 업무 수 (1~4)
WORKER_CONCURRENCY=1

# ─── 데이터 ───────────────────────────────────────────
DATABASE_PATH=./data/company.db

# ─── 외부 공개 시 필수 (로컬 전용이면 비워둠) ────────────
# 값이 있으면 모든 페이지와 API에 이 비밀번호가 필요합니다.
APP_PASSWORD=
